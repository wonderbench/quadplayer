    <string name="about_detail_01">QuadPlayer is an Android player for up to four videos at once. Switch audio between views while comparing footage or watching multiple angles.</string>
    <string name="about_detail_02">Quad playback</string>
    <string name="about_detail_03">Play up to four videos in a 2×2 grid.</string>
    <string name="about_detail_04">Double-tap a view or use its audio button to select its sound.</string>
    <string name="about_detail_05">Optional crossfade makes audio switches smoother.</string>
    <string name="about_detail_06">Play or pause all, synchronize positions and change speed together.</string>
    <string name="about_detail_07">Seek, pause or replace each video independently.</string>
    <string name="about_detail_08">Touch and hold a view to open its menu and swap positions.</string>
    <string name="about_detail_09">Single-video playback</string>
    <string name="about_detail_10">Play, pause, seek and see buffering status.</string>
    <string name="about_detail_11">Choose speeds from 0.5x to 3.0x.</string>
    <string name="about_detail_12">Choose fit, fill, zoom, 16:9, 4:3 or original aspect ratio.</string>
    <string name="about_detail_13">Use external subtitles, multiple audio tracks and volume or brightness gestures.</string>
    <string name="about_detail_14">Resume from the previous position.</string>
    <string name="about_detail_15">Media library</string>
    <string name="about_detail_16">Find local videos on the device.</string>
    <string name="about_detail_17">Browse by folder, filter, search and sort.</string>
    <string name="about_detail_18">Manage favorites, recent history and playlists.</string>
    <string name="about_detail_19">Preferences</string>
    <string name="about_detail_20">Choose a theme, decoder and default speed.</string>
    <string name="about_detail_21">Choose the double-tap seek interval and direction.</string>
    <string name="about_detail_22">Configure background playback, resume and audio crossfade.</string>
    <string name="about_detail_23">Operating system</string>
    <string name="about_detail_24">Android 8.0 (API 26) or later</string>
    <string name="about_detail_25">Recommended memory</string>
    <string name="about_detail_26">4 GB or more (quad playback uses up to four decoders)</string>
    <string name="about_detail_27">Video access</string>
    <string name="about_detail_28">Access to video files is required for the library</string>
    <string name="about_detail_29">QuadPlayer checks device capabilities and warns about limited memory or decoders. It also monitors memory and thermal status during playback.</string>
    <string name="about_detail_30">Getting started</string>
    <string name="about_detail_31">Allow video access to scan local videos.</string>
    <string name="about_detail_32">Find the library, recent videos, favorites and playlists on Home.</string>
    <string name="about_detail_33">Tap a video to play it.</string>
    <string name="about_detail_34">Open Quad from navigation to add up to four videos.</string>
    <string name="about_detail_35">Quad controls</string>
    <string name="about_detail_36">Tap an empty slot to add a video.</string>
    <string name="about_detail_37">Tap a view for its progress bar; double-tap or use its audio button to change the audio source.</string>
    <string name="about_detail_38">Use the controls to play or pause all, synchronize positions and change speed.</string>
    <string name="about_detail_39">Touch and hold a view, start a swap, then complete it from the target view menu.</string>
    <string name="about_detail_40">Remove or replace a video from its view menu.</string>
